{
  "expo": {
    "name": "Spectrum AI",
    "slug": "spectrum-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-spectrumai.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon-spectrumai.png",
      "resizeMode": "contain",
      "backgroundColor": "#001881"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-spectrumai.png",
        "backgroundColor": "#001881"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aevumsystems.spectrumai"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#FAFBFE",
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "5d0b5117-4681-4497-9ec1-dc7bd1cfe26d"
      }
    },
    "owner": "spectrum-ai"
  }
}
